{
  "manifest_version": 3,
  "name": "BadAsso → Calendrier",
  "version": "1.2.0",
  "description": "Exporte tes créneaux de badminton réservés sur BadAsso vers un fichier .ics (Google Calendar, Apple Calendar, Outlook).",
  "permissions": [
    "scripting",
    "activeTab",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://bad-asso.fr/*",
    "https://*.bad-asso.fr/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Exporter mon planning BadAsso",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://bad-asso.fr/*",
        "https://*.bad-asso.fr/*"
      ],
      "world": "MAIN",
      "js": [
        "core.js",
        "inpage.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
